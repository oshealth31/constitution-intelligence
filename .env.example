# =============================================================================
# Constitution Intelligence — server-side environment (API, database scripts)
# =============================================================================
# 1. Copy this file to ".env" in the same folder:   cp .env.example .env
# 2. Replace every "replace-me" value with your own LOCAL values.
# 3. Never commit ".env". It is listed in .gitignore.
#
# This file is for LOCAL DEVELOPMENT ONLY. Staging and production values are
# set in the hosting provider's secret manager, never in a file in the repo.
# When NODE_ENV=production the application does not read any .env file.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# NODE_ENV: development | test | production
NODE_ENV=development
# APP_ENV (where this copy runs): local | test | staging | production
APP_ENV=local

# --- API server --------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
# Comma-separated list of web origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000
# Set to true only when running behind a trusted load balancer / reverse proxy.
TRUST_PROXY=false

# --- Logging -----------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Human-readable logs for local development. Must be false in staging/production.
LOG_PRETTY=true

# --- Local PostgreSQL (used by infra/docker-compose.yml) ---------------------
POSTGRES_USER=constitution
POSTGRES_PASSWORD=replace-me-with-a-local-password
POSTGRES_DB=constitution_dev
POSTGRES_PORT=5432

# --- Database connection used by the API and migrations ----------------------
# Use the same user and password as above.
DATABASE_URL=postgresql://constitution:replace-me-with-a-local-password@localhost:5432/constitution_dev
# Separate database used by automated tests (created automatically by Docker).
TEST_DATABASE_URL=postgresql://constitution:replace-me-with-a-local-password@localhost:5432/constitution_test
# Must be true in staging and production (encrypted database connection).
DATABASE_SSL=false
DATABASE_POOL_MAX=10
