# Dependencies
node_modules/

# Build output
dist/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Test output
coverage/
playwright-report/
test-results/
apps/web/e2e/.auth/

# Local file storage and other runtime data
.data/

# Environment files: real values must never be committed.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Operating system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Production server files: secrets, filled-in settings and backups are never committed.
infra/production/secrets/*
!infra/production/secrets/README.md
infra/production/api.env
infra/production/.env
infra/production/backups/
infra/production/exports/
infra/production/ci-mail/
