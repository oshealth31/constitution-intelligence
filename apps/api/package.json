{
  "name": "@constitution/api",
  "version": "0.1.0",
  "private": true,
  "description": "Constitution Intelligence API (NestJS modular monolith).",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "super-admin:create": "nest build && node dist/cli/create-super-admin.js",
    "seed:dev": "nest build && node dist/cli/seed-dev.js"
  },
  "dependencies": {
    "@constitution/db": "workspace:*",
    "@constitution/shared": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.1.0",
    "nestjs-pino": "^4.4.0",
    "nodemailer": ">=7.0.7 <9",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.13.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": ">=7.0.0 <9",
    "@types/pg": "^8.15.0",
    "@types/smtp-server": "^3.5.9",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.0.0",
    "smtp-server": "^3.13.7",
    "supertest": "^7.1.0",
    "typescript": "~5.9.2",
    "unplugin-swc": "^1.5.5",
    "vitest": "^3.2.0"
  }
}
