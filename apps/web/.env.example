# =============================================================================
# Constitution Intelligence — web front end environment
# =============================================================================
# Copy to "apps/web/.env.local" for local development. Never commit .env.local.
#
# WARNING: every variable starting with NEXT_PUBLIC_ is built into the JavaScript
# sent to browsers and is visible to anyone. NEVER put passwords, API keys or
# other secrets in this file.
# =============================================================================

# Base URL of the API, as seen from the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Server-side only (not visible to browsers): where the web app forwards /api/v1/* requests.
# Read when the web app is built or started in development.
API_INTERNAL_URL=http://127.0.0.1:4000
