# Non-secret settings for the production server (Task S2). Read by ops/server/release.sh on every
# release to write the server's .env and api.env. Change them here, in a pull request, then run a
# release. Secrets are NOT here: they are files on the server (docs/operations/secrets.md) or
# GitHub secrets used by the Deploy workflow (docs/operations/oracle-cloud.md).

# The public web address (DNS: task S4). Caddy gets the HTTPS certificate for it.
SITE_ADDRESS=constitutionintel.com
# Sender address on the Brevo-authenticated domain.
MAIL_FROM=Constitution Intelligence <no-reply@constitutionintel.com>
# Optional: a mailbox people can reply to (leave empty if there is none yet).
MAIL_REPLY_TO=
# Shown to organisations on invoices (not secret). Leave empty until bank details are decided.
BILLING_PAYMENT_INSTRUCTIONS=

# Off-site backups (Task S6): rclone destinations in the owner's Oracle Object Storage, set up
# by the Deploy workflow task "setup-offsite". The access key is a secret on the server only
# (secrets/rclone.conf).
OFFSITE_REMOTE=offsite:constitution-backups/prod
OFFSITE_AUDIT_REMOTE=offsite:constitution-audit-seals/prod
