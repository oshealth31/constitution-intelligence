# =============================================================================
# API settings for staging / production. Copy to "api.env" on the server.
# NOT SECRET: secrets are files in ./secrets/ (see docs/operations/secrets.md).
# Never copy values from a development .env file. Every setting is checked at start-up and
# the API refuses to start with unsafe values.
# =============================================================================
APP_ENV=production
APP_VERSION=set-by-deployment
CORS_ORIGINS=https://portal.example.co.bw
WEB_BASE_URL=https://portal.example.co.bw
# Caddy -> web app -> API
TRUST_PROXY=2
LOG_LEVEL=info
LOG_PRETTY=false
DATABASE_SSL=true
DATABASE_POOL_MAX=10
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/var/lib/constitution/storage
# Two-step sign-in: MFA_ENCRYPTION_KEY is the secret file secrets/mfa_encryption_key
# (docker-compose.yml passes MFA_ENCRYPTION_KEY_FILE). Do not put the key in this file.
# Email (invitations, password resets) through the provider's SMTP server, always encrypted.
# Brevo: host smtp-relay.brevo.com, port 587, STARTTLS, login = the SMTP login shown in Brevo.
# The SMTP password (Brevo "SMTP key") is the secret file secrets/smtp_password.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=your-smtp-login@smtp-brevo.com
MAIL_FROM=Constitution Intelligence <no-reply@portal.example.co.bw>
MAIL_REPLY_TO=support@portal.example.co.bw
# AI stays off for launch (data protection decision).
AI_PROVIDER=disabled
SUBSCRIPTION_DATA_RETENTION_DAYS=90
OFFLINE_COPY_MAX_AGE_DAYS=30
# BILLING_PAYMENT_INSTRUCTIONS=Pay by EFT to ... using your invoice number as the reference.
